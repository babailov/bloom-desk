{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloom-desk",
  "main": "src/index.ts",
  // Pinned to what the vitest pool's bundled workerd supports, so tests and
  // production run the same runtime semantics. Raise both together.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloom",
      "database_id": "2e6ac209-9017-4c1a-9e5c-e0b281b85c82",
      "migrations_dir": "migrations"
    }
  ]
}
