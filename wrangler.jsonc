{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bloom-desk",
  "main": "src/index.ts",
  // Pinned to what the vitest pool's bundled workerd supports, so tests and
  // production run the same runtime semantics. Raise both together.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./ui",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bloom",
      "database_id": "PLACEHOLDER_SET_BY_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ]
}
